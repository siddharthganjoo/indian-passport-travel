# ==============================================================================
# Indian Passport Travel & Visa Metasearch Platform
# Environment Configuration
# ==============================================================================

# Server-Side Only Secrets (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Amadeus Flight API Credentials
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Duffel Flight API Token
DUFFEL_API_TOKEN=your_duffel_token_here

# Upstash Redis for Flight Fare Snapshot Caching & Rate Limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Supabase Database (Server-side service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Public Config
NEXT_PUBLIC_APP_URL=https://indianpassporttravel.com
NEXT_PUBLIC_SITE_NAME="DesiVisa - Indian Passport Travel & Visa Metasearch"
