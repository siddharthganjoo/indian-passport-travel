# ==============================================================================
# DesiVisa — environment configuration
# Everything is optional for local development: without keys the app uses the
# JSON dataset in data/ and clearly-labelled sample fares.
# ==============================================================================

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (transaction pooler, port 6543).
# Then run: npm run db:setup
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Flight prices ─────────────────────────────────────────────────────────────
# Travelpayouts (Aviasales Data API): cached cheapest fares, used to scan routes.
# https://www.travelpayouts.com → Tools → API
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Duffel: live price + exact baggage, called only when a user clicks "Check live price & bags".
# https://app.duffel.com → Developers → Access tokens
DUFFEL_API_TOKEN=

# ── Admin (/admin) ────────────────────────────────────────────────────────────
# Required in production — without it /admin is disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Caching & rate limiting (Upstash Redis) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Fallback USD→INR rate when live FX is unavailable.
FX_USD_INR=88
NEXT_PUBLIC_APP_URL=https://jugo.travel
# Shown on Help / Privacy / Terms (hidden when empty)
NEXT_PUBLIC_SUPPORT_EMAIL=
# Legal entity name shown on the privacy policy
NEXT_PUBLIC_LEGAL_NAME=
